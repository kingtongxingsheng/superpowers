digraph STYLE_GUIDE {
    // 使用 DSL 本身编写的流程 DSL 风格指南

    // 节点类型及其形状示例
    subgraph cluster_node_types {
        label="节点类型和形状";

        // 问题使用菱形
        "这是一个问题吗？" [shape=diamond];

        // 动作使用方框（默认形状）
        "执行一个动作" [shape=box];

        // 命令使用纯文本
        "git commit -m 'msg'" [shape=plaintext];

        // 状态使用椭圆
        "当前状态" [shape=ellipse];

        // 警告使用八边形
        "停止：严重警告" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        // 入口/出口使用双圆
        "流程开始" [shape=doublecircle];
        "流程完成" [shape=doublecircle];

        // 各类型示例
        "测试通过了吗？" [shape=diamond];
        "先写测试" [shape=box];
        "npm test" [shape=plaintext];
        "我卡住了" [shape=ellipse];
        "绝不要使用 git add -A" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
    }

    // 边标签约定
    subgraph cluster_edge_types {
        label="边标签";

        "二选一的决定？" [shape=diamond];
        "是路径" [shape=box];
        "否路径" [shape=box];

        "二选一的决定？" -> "是路径" [label="是"];
        "二选一的决定？" -> "否路径" [label="否"];

        "多选题？" [shape=diamond];
        "选项 A" [shape=box];
        "选项 B" [shape=box];
        "选项 C" [shape=box];

        "多选题？" -> "选项 A" [label="条件 A"];
        "多选题？" -> "选项 B" [label="条件 B"];
        "多选题？" -> "选项 C" [label="否则"];

        "流程 A 完成" [shape=doublecircle];
        "流程 B 开始" [shape=doublecircle];

        "流程 A 完成" -> "流程 B 开始" [label="触发", style=dotted];
    }

    // 命名模式
    subgraph cluster_naming_patterns {
        label="命名模式";

        // 问题以 ? 结尾
        "我应该执行 X 吗？";
        "这可以是 Y 吗？";
        "Z 是真的吗？";
        "我完成 W 了吗？";

        // 动作以动词开头
        "编写测试";
        "搜索模式";
        "提交变更";
        "寻求帮助";

        // 命令保持字面形式
        "grep -r 'pattern' .";
        "git status";
        "npm run build";

        // 状态描述当前情形
        "测试失败";
        "构建完成";
        "卡在错误上";
    }

    // 流程结构模板
    subgraph cluster_structure {
        label="流程结构模板";

        "触发：某件事发生" [shape=ellipse];
        "初始检查？" [shape=diamond];
        "主要动作" [shape=box];
        "git status" [shape=plaintext];
        "再次检查？" [shape=diamond];
        "替代动作" [shape=box];
        "停止：不要这样做" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "流程完成" [shape=doublecircle];

        "触发：某件事发生" -> "初始检查？";
        "初始检查？" -> "主要动作" [label="是"];
        "初始检查？" -> "替代动作" [label="否"];
        "主要动作" -> "git status";
        "git status" -> "再次检查？";
        "再次检查？" -> "流程完成" [label="正常"];
        "再次检查？" -> "停止：不要这样做" [label="有问题"];
        "替代动作" -> "流程完成";
    }

    // 何时使用哪种形状
    subgraph cluster_shape_rules {
        label="各种形状的适用场景";

        "选择形状" [shape=ellipse];

        "这是一个决定吗？" [shape=diamond];
        "使用菱形" [shape=diamond, style=filled, fillcolor=lightblue];

        "这是一个命令吗？" [shape=diamond];
        "使用纯文本" [shape=plaintext, style=filled, fillcolor=lightgray];

        "这是一个警告吗？" [shape=diamond];
        "使用八边形" [shape=octagon, style=filled, fillcolor=pink];

        "这是入口/出口吗？" [shape=diamond];
        "使用双圆" [shape=doublecircle, style=filled, fillcolor=lightgreen];

        "这是一个状态吗？" [shape=diamond];
        "使用椭圆" [shape=ellipse, style=filled, fillcolor=lightyellow];

        "默认：使用方框" [shape=box, style=filled, fillcolor=lightcyan];

        "选择形状" -> "这是一个决定吗？";
        "这是一个决定吗？" -> "使用菱形" [label="是"];
        "这是一个决定吗？" -> "这是一个命令吗？" [label="否"];
        "这是一个命令吗？" -> "使用纯文本" [label="是"];
        "这是一个命令吗？" -> "这是一个警告吗？" [label="否"];
        "这是一个警告吗？" -> "使用八边形" [label="是"];
        "这是一个警告吗？" -> "这是入口/出口吗？" [label="否"];
        "这是入口/出口吗？" -> "使用双圆" [label="是"];
        "这是入口/出口吗？" -> "这是一个状态吗？" [label="否"];
        "这是一个状态吗？" -> "使用椭圆" [label="是"];
        "这是一个状态吗？" -> "默认：使用方框" [label="否"];
    }

    // 好与坏的示例
    subgraph cluster_examples {
        label="好示例与坏示例";

        // 好示例：具体且形状正确
        "测试失败" [shape=ellipse];
        "读取错误消息" [shape=box];
        "可以复现吗？" [shape=diamond];
        "git diff HEAD~1" [shape=plaintext];
        "绝不要忽略错误" [shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        "测试失败" -> "读取错误消息";
        "读取错误消息" -> "可以复现吗？";
        "可以复现吗？" -> "git diff HEAD~1" [label="是"];

        // 坏示例：含糊且形状错误
        bad_1 [label="出了点问题", shape=box];  // 应为椭圆（状态）
        bad_2 [label="修好它", shape=box];  // 过于含糊
        bad_3 [label="检查", shape=box];  // 应为菱形
        bad_4 [label="运行命令", shape=box];  // 应为包含实际命令的纯文本

        bad_1 -> bad_2;
        bad_2 -> bad_3;
        bad_3 -> bad_4;
    }
}
